# ---------------------------------------------------------------------------
# STRONGER — environment template
#
# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API). .env.local is gitignored.
#
# Both values below are safe to expose to the browser: the publishable key
# only grants what Row Level Security allows.
#
# NEVER put a service-role key in this file or in any NEXT_PUBLIC_ variable.
# It bypasses RLS entirely and must stay server-side only.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
